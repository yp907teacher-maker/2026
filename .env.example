# 富邦新一代 API 登入資訊，複製為 .env 並填入實際值，切勿提交 .env 到版控
FUBON_ID=
FUBON_PASSWORD=
FUBON_CERT_PATH=
FUBON_CERT_PASS=

# FinMind API（可選，免登入也能用，但請求額度較低）
FINMIND_TOKEN=

# 每日 Email 通知寄信設定（Phase 5）。Gmail 請用「應用程式密碼」，一般登入密碼無法用於 SMTP。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# 私人狀態同步（NAV 基準值跨 GitHub Actions 執行保留，見 src/state_sync.py）。
# 本機執行不需要設定這個，daily_pipeline.py 沒偵測到就會直接用本機檔案。
# 只有在 GitHub Actions 的 Secrets 才需要設定成有 2026-private-state repo 寫入權限的 PAT。
STATE_REPO_TOKEN=
