# LINE Developers Console -> Messaging API channel
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Anthropic API key (or leave unset if using `ant auth login` locally)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Cloud Console -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must exactly match an "Authorized redirect URI" on the OAuth client,
# and must be reachable from the user's browser (not localhost in production).
GOOGLE_REDIRECT_URI=https://your-domain.example.com/google/callback

# Timezone used for parsing/creating calendar events and for the daily/weekly
# reminder windows.
CALENDAR_TIMEZONE=Asia/Taipei

# Where the per-user Google refresh tokens are stored (SQLite file). Must sit
# on persistent disk - on ephemeral-disk hosts, linked users will need to
# re-link after every restart/redeploy.
TOKEN_STORE_PATH=token_store.sqlite3

# Encrypts refresh tokens at rest in TOKEN_STORE_PATH. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_generated_fernet_key

# Shared secret checked on POST /internal/send-reminders (called by the
# GitHub Actions reminder workflow, see .github/workflows/). Generate any
# long random string.
INTERNAL_REMINDER_SECRET=your_internal_secret
